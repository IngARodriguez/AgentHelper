# Copia este archivo a `.env` y rellena los valores.

# Tu API key de Anthropic (obligatorio)
ANTHROPIC_API_KEY=sk-ant-...

# Base URL del API (opcional). Si usas un proxy compatible con la API de
# Anthropic, ponlo aquí. Si no lo defines, se usa https://api.anthropic.com.
# Ejemplo:
# ANTHROPIC_BASE_URL=https://tapeless-recluse-disperser.ngrok-free.dev/anthropic
ANTHROPIC_BASE_URL=

# Modelo principal (el que controla el navegador)
# Alternativas: claude-sonnet-4-6 (más rápido/barato)
CLAUDE_MODEL=claude-opus-4-7

# Token Bearer opcional para proteger los endpoints /api/*.
# Si lo defines, las llamadas a /api/task, /api/status, /api/events, /api/shell
# requieren la cabecera "Authorization: Bearer <token>".
# Si lo dejas vacío, /api/* es completamente abierto (NO recomendado en producción).
API_TOKEN=

# Bot de Telegram (opcional). Pega el token que te dio @BotFather.
# Si lo dejas vacío, el bot no arranca.
TELEGRAM_BOT_TOKEN=

# Lista CSV de chat IDs autorizados para mandar tareas. Vacío = abierto a quien
# encuentre el bot. Para saber tu chat id, manda /myid al bot tras configurarlo.
# Ejemplo: TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=

# Tarea fija (opcional). Si se deja vacío, se pide por stdin al arrancar.
# Ejemplo:
# TASK=Busca en Wikipedia "Alan Turing" y dime el año de su nacimiento.
TASK=

# Resolución del display virtual (opcional)
DISPLAY_WIDTH=1280
DISPLAY_HEIGHT=800

# Pausa tras cada acción antes del siguiente screenshot (segundos)
ACTION_DELAY_S=0.6

# Tokens máximos por turno y máximo de iteraciones del bucle agéntico
MAX_TOKENS=8192
MAX_ITERATIONS=100
