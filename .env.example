# Copia este archivo a `.env` y rellena los valores.
# Solo `ANTHROPIC_API_KEY` es OBLIGATORIO. Todo lo demás tiene defaults sensatos.

# ─── Anthropic API (obligatorio) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Base URL del API (opcional). Si usas un proxy compatible con la API de
# Anthropic, ponlo aquí. Vacío = https://api.anthropic.com
# Ejemplo: ANTHROPIC_BASE_URL=https://tu-proxy.example.com/anthropic
ANTHROPIC_BASE_URL=

# Modelo principal. Alternativas: claude-sonnet-4-6 (más rápido/barato),
# claude-haiku-4-5 (aún más rápido, peor visión).
CLAUDE_MODEL=claude-opus-4-7

# ─── API pública (opcional) ──────────────────────────────────────────────────
# Token Bearer para /api/*. Si lo defines, las llamadas requieren
# "Authorization: Bearer <token>". Vacío = endpoints abiertos.
API_TOKEN=

# ─── Bot de Telegram (opcional) ──────────────────────────────────────────────
# Token de @BotFather. Vacío = bot desactivado.
TELEGRAM_BOT_TOKEN=
# CSV de chat IDs autorizados. Vacío = cualquiera puede usar el bot.
TELEGRAM_ALLOWED_CHAT_IDS=

# ─── Display virtual ─────────────────────────────────────────────────────────
DISPLAY_WIDTH=1280
DISPLAY_HEIGHT=800
DISPLAY_DEPTH=24

# ─── Performance / coste ─────────────────────────────────────────────────────
# Pausa tras cada acción antes del siguiente screenshot (segundos)
ACTION_DELAY_S=0.4
# Tokens máx por turno y tope de iteraciones del bucle agéntico
MAX_TOKENS=8192
MAX_ITERATIONS=100
# Cuántos screenshots recientes conservar en el historial. 0 = sin truncar
# (se mandan todos al modelo, llena más contexto). 10 = continuidad visual
# amplia y aún manejable en tareas muy largas.
KEEP_RECENT_SCREENSHOTS=10
# Formato del screenshot al modelo: jpeg (default, ~3-5x menos bytes) o png.
SCREENSHOT_FORMAT=jpeg
# Calidad JPEG 1-95. 90 = casi indistinguible de PNG. Sube a 95 si tienes
# tareas con texto muy pequeño.
SCREENSHOT_QUALITY=90

# ─── OSINT API keys (todas opcionales) ───────────────────────────────────────
# El agente las usa si están definidas; si no, cae a métodos públicos sin key.
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
HIBP_API_KEY=
GITHUB_TOKEN=
VIRUSTOTAL_API_KEY=

# ─── Otros ───────────────────────────────────────────────────────────────────
# Tarea fija de arranque (vacío = se usa solo el dashboard / API / Telegram)
TASK=
